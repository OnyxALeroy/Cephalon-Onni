# Database Connections
SPRING_DATASOURCE_URL=jdbc:postgresql://cephalon-onni-postgres:5432/cephalon_onni
REDIS_HOST=cephalon-onni-redis
REDIS_PORT=6379

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=SuperSecretPassword
POSTGRES_DB=cephalon_onni

# Auth - generate a real random value, e.g. `openssl rand -base64 48`. The backend refuses to
# start if this is unset or shorter than 32 bytes (see JwtService) - the old backend hardcoded
# this in source ("looking cool joker"), which is exactly what we're fixing here.
JWT_SECRET=

# CORS - comma-separated list of origins allowed to send credentialed requests. Same-origin
# deployments (nginx/vite proxying /api/*, the normal setup here) don't need this touched.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Cookies - set to true in production (behind TLS) so the access_token cookie gets the
# Secure flag. Leave false for plain-HTTP local dev.
APP_COOKIE_SECURE=false

# Worldstate polling - how often (ms) the backend re-polls api.warframe.com for fresh
# alerts/fissures. 10000 (10s) is the default.
WORLDSTATE_POLL_INTERVAL_MS=10000
